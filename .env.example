# MemVault 配置模板(.env)
# ========================
#
# 用法:把本文件复制为 ~/.memvault/.env(或 $MEMVAULT_HOME/.env),按需取消注释。
# 所有 binary(memvault-cli / memvault-mcp / memvault-proxy)启动时自动加载,
# 也可用 --env-file <路径> 指定其他文件,或用环境变量 MEMVAULT_ENV_FILE 指定。
#
# 取值优先级(高 → 低):
#   1. CLI flag(如 --db)
#   2. 进程环境变量(mcpServers 的 env 注入 / shell export / CI)
#   3. 本文件
#   4. 各读取点的内置默认值
# 文件不存在时静默跳过——零配置即可用。
# 已在环境变量里出现的键不会被文件覆盖(环境变量优先)。
# 运行 `memvault status` 可查看当前每项配置的实际来源(env / file / default)。
#
# 本文件只承载"server 配置"(crates 代码读取的键)。两类东西不在这里:
#   - 宿主安装合同变量(MEMVAULT_AGENT_ID / MEMVAULT_HOOK_EXTRACT / MEMVAULT_BIN 等)
#     ——per-agent 值,由各 agent 的 plugin / mcpServers env 注入;
#   - proxy 的 upstreams 拓扑(结构化列表)——在 ~/.memvault/proxy.yaml(--config)。
#
# 布尔值统一写 true / false;解析器兼容 on/off/1/0/yes/no/enabled/disabled。

# ─── 基础目录与存储 ───────────────────────────────────────
# 基础目录:.env 自身、模型缓存(~/.memvault/models)、agents.yaml 等的根。
# 注意:该变量只能来自进程环境,不能写进 .env(文件无法定义自己所在的目录)。
# MEMVAULT_HOME=
# SQLite 数据文件路径(默认: ~/.memvault/data.db)
# MEMVAULT_DB=~/.memvault/data.db
# SQLite 连接池大小(默认: 5)
# MEMVAULT_DB_POOL_SIZE=5

# ─── Embedding(语义检索,默认内嵌本地模型)─────────────────
# Provider 选择:
#   1. MEMVAULT_EMBEDDING_PROVIDER 显式指定(见下)
#   2. 未指定但设置了 MEMVAULT_EMBEDDING_API_KEY 或 OPENAI_API_KEY → 猜成 openai
#      (OPENAI_API_KEY 仅作为 key 兜底;旧名 OPENAI_API_BASE 已移除,端点只认
#      MEMVAULT_EMBEDDING_API_BASE)
#   3. 均未设置 → native(内嵌本地模型,零外部服务)
# 可选值:
#   native(默认)       → 进程内推理:fastembed + ONNX Runtime,无需安装任何服务
#   ollama / local     → 本地 Ollama 服务(http://localhost:11434)
#   auto               → 优先本地 Ollama,未运行则回退 native(离线优先)
#   openai / openai-compatible / 任意值 → 任意 OpenAI 兼容端点(Azure / vLLM / 网关…)
#   none               → 禁用语义检索(纯关键词)
# MEMVAULT_EMBEDDING_PROVIDER=native

# native 模型(仅 provider=native 生效):
#   不设 / zh 或 bge-small-zh → bge-small-zh-v1.5(中文,~95MB,体积小)
#   multilingual / e5-base   → multilingual-e5-base(多语言,~470MB)
# API provider 默认: text-embedding-3-small
# MEMVAULT_EMBEDDING_MODEL=

# native 首次使用会从 HuggingFace 下载模型;国内网络可指定镜像(标准变量):
# HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录默认 ~/.memvault/models(MEMVAULT_HOME 改根目录)

# API key(provider=openai* 时用,本地可留空; OPENAI_API_KEY 为兜底别名)
# MEMVAULT_EMBEDDING_API_KEY=sk-your-api-key-here
# API 端点(OpenAI 兼容协议;默认 https://api.openai.com/v1,ollama 时为 11434/api)
# MEMVAULT_EMBEDDING_API_BASE=
# 输出维度(API provider 默认 1536;native/ollama 自动探测)
# MEMVAULT_EMBEDDING_DIM=

# ─── LLM 提取/反思(可选,本地优先)────────────────────────
# 开启后 context 提取 / 失败反思 / 关系抽取用 chat 模型理解全文;
# LLM 不可用时自动回退纯规则,不会报错。
#   (不设置) / auto            → 自动探测本机 Ollama:跑着就用,没跑则纯规则
#   ollama / local             → 显式本地 Ollama(行为确定,推荐)
#   openai / openai-compatible / 任意值 → 显式远程 OpenAI 兼容端点
#   off / disabled / none      → 强制纯规则(即使本机有 Ollama)
# MEMVAULT_LLM_EXTRACTION_PROVIDER=ollama
# Ollama 的 OpenAI 兼容 chat 端点(默认 http://localhost:11434/v1;远程默认
# https://api.openai.com/v1)
# MEMVAULT_LLM_EXTRACTION_API_BASE=
# chat 模型(本地默认 qwen2.5:7b,小机器可用 qwen2.5:3b-instruct;远程默认 gpt-4o-mini)
# MEMVAULT_LLM_EXTRACTION_MODEL=
# 本地无需 key;远程 provider 时设置(兜底 OPENAI_API_KEY)
# MEMVAULT_LLM_EXTRACTION_API_KEY=

# 本地 Ollama 零成本方案:
#   1) brew install ollama && brew services start ollama
#   2) ollama pull nomic-embed-text     # 嵌入(ollama/auto 默认,768 维)
#      ollama pull qwen2.5:7b           # chat:LLM 提取/反思(本地默认)
#   3) 不配任何变量即可(LLM 提取自动探测);显式开则设上面两个 PROVIDER。

# ─── 提取与写入行为 ──────────────────────────────────────
# 从 agent 回复文本提取记忆的开关(false → 完全不提取,默认 true=提取但降级为
# review:required 待审;用户原话的提取不受此开关影响)
# MEMVAULT_EXTRACT_ASSISTANT=true
# save 时 delta 写入:同命名空间先查重,近重复跳过、相似项合并残差(默认 true;
# 单次旁路用 --force / force_insert)。见 docs/PAPER-INSPIRATIONS.md Feature A。
# MEMVAULT_DELTA_WRITE=true
# extract_memories(mode=llm) 额外持久化 supports/contradicts/sourced_from 关系
# 三元组(默认 false)
# MEMVAULT_RELATIONS=false
# 会话 n-gram 检索窗口:proxy 注入用最近多少轮观察构造按新近度加权的检索键(默认 5)
# MEMVAULT_CONTEXT_NGRAM_WINDOW=5

# ─── 信任与合规 ──────────────────────────────────────────
# 记录 save_memory 调用的 agent 身份是否经过 agents.yaml API key 校验
# (Memory.identity_verified;仅记录,不影响信任决策,默认 true)
# MEMVAULT_IDENTITY_VERIFICATION=true
# 佐证门:身份验证过的多个不同 agent 独立佐证的 MUST 记忆,无需人审即可信
# (默认 false = 关)
# MEMVAULT_CORROBORATION_GATE=false
# 佐证门所需的不同身份验证 agent 数量下限(默认 2)
# MEMVAULT_CORROBORATION_MIN_AGENTS=2

# ─── REST API(仅 --transport http)───────────────────────
# CORS 允许来源:逗号分隔 origin 列表,* 显式放行所有来源(非可信网络不推荐)。
# 未设置时默认仅允许本机(127.0.0.1 / localhost,任意端口)。
# MEMVAULT_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5173

# ─── 日志 ────────────────────────────────────────────────
# 日志级别(格式: [target=]level,默认: info;.env 里设置同样生效——加载先于
# tracing 初始化)
# RUST_LOG=info,memvault_core=debug
