# MemVault 环境变量配置
# ======================
# 复制此文件为 .env 并按需修改配置

# ─── OpenAI Embedding ──────────────────────────────────────
# 必需（语义搜索需要）。若未设置，MemVault 以降级为关键字搜索模式运行。
OPENAI_API_KEY=sk-your-api-key-here

# 可选：自定义 Embedding API 端点（兼容 OpenAI 协议）
# OPENAI_API_BASE=https://api.openai.com/v1

# 可选：Embedding 模型名（默认: text-embedding-3-small）
# MEMVAULT_EMBEDDING_MODEL=text-embedding-3-small

# 可选：Embedding 输出维度（默认: 1536）
# MEMVAULT_EMBEDDING_DIM=1536

# ─── MemVault Server ──────────────────────────────────────
# MCP Server 数据文件路径（默认: ~/.memvault/data.db）
# MEMVAULT_DB=~/.memvault/data.db

# ─── 日志 ──────────────────────────────────────────────────
# 日志级别（格式: [target=]level，默认: info）
# RUST_LOG=info,memvault_core=debug