# MemVault 环境变量配置
# ======================
# 复制此文件为 .env 并按需修改配置

# ─── Embedding ────────────────────────────────────────────
# Provider 选择优先级:
#   1. MEMVAULT_EMBEDDING_PROVIDER 显式指定
#   2. 设置了 OPENAI_API_KEY / OPENAI_API_BASE → 走兼容 API(向后兼容)
#   3. 均未设置 → 默认 native(内嵌本地模型,零外部服务)

# 可选：Embedding 提供商类型:
#   native(默认)       → 进程内推理:fastembed + ONNX Runtime,无需安装任何服务
#   ollama / local     → 本地 Ollama 服务(http://localhost:11434)
#   auto               → 优先本地 Ollama,未运行则回退 native(离线优先)
#   openai / openai-compatible / 任意值 → 任意 OpenAI 兼容端点(Azure / vLLM / 网关…)
#   none               → 禁用语义检索(纯关键词)
# MEMVAULT_EMBEDDING_PROVIDER=native

# native 模型选择(仅 provider=native 时生效):
#   不设 / zh 或 bge-small-zh → bge-small-zh-v1.5(中文,~95MB,体积小)
#   multilingual / e5-base   → multilingual-e5-base(多语言,~470MB)
# MEMVAULT_EMBEDDING_MODEL=

# native 首次使用会从 HuggingFace 下载模型;国内网络可指定镜像(标准 HF_ENDPOINT 变量):
# HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录默认: ~/.memvault/models(可由 MEMVAULT_HOME 覆盖基础目录)

# API 提供商时使用(本地可留空)。任意 OpenAI 兼容服务均可用。
# OPENAI_API_KEY=sk-your-api-key-here

# 自定义 Embedding API 端点(兼容 OpenAI 协议,如 https://api.openai.com/v1 | https://your-host/v1)
# OPENAI_API_BASE=https://api.openai.com/v1
# 或等价的新命名(优先级更高):
# MEMVAULT_EMBEDDING_API_BASE=

# API Key(与 OPENAI_API_KEY 等价,优先级更高):
# MEMVAULT_EMBEDDING_API_KEY=

# 可选：Embedding 模型名(API 提供商:默认 text-embedding-3-small)
# MEMVAULT_EMBEDDING_MODEL=

# 可选：Embedding 输出维度(API 提供商:默认 1536;native 自动探测)
# MEMVAULT_EMBEDDING_DIM=
#
# ─── 本地 Ollama(零成本,推荐演示方式)───────────────────────
# 1) 安装并启动: brew install ollama && brew services start ollama
# 2) 拉取模型:
#    ollama pull nomic-embed-text      # 嵌入,768 维(provider=ollama/auto 默认)
#    ollama pull qwen2.5:3b-instruct   # chat:LLM 提取/反思(默认 qwen2.5:7b,需自行拉取或指定)
# 3) 显式启用(也可不配——LLM 提取不设/auto 时会自动探测本机 Ollama):
#    MEMVAULT_EMBEDDING_PROVIDER=ollama
#    MEMVAULT_LLM_EXTRACTION_PROVIDER=ollama
#    MEMVAULT_LLM_EXTRACTION_MODEL=qwen2.5:3b-instruct
#
# provider=ollama/local 时嵌入走 Ollama 原生 /api/embed,默认:
#   端点 http://localhost:11434/api · 模型 nomic-embed-text · 维度 768
# (等价覆盖: MEMVAULT_EMBEDDING_API_BASE / MEMVAULT_EMBEDDING_MODEL / MEMVAULT_EMBEDDING_DIM)

# ─── LLM 提取(可选,本地优先)───────────────────────────────
# 开启后 extract_memories(mode=llm)/失败反思/关系抽取用 chat 模型理解全文;
# LLM 不可用时自动回退纯规则,不会报错。
#   (不设置) / auto            → 自动探测本机 Ollama:跑着就用,没跑则纯规则
#   ollama / local             → 显式本地 Ollama(行为确定,推荐)
#   openai / openai-compatible / 任意值 → 显式远程 OpenAI 兼容端点
#   off / disabled / none      → 强制纯规则(即使本机有 Ollama)
# MEMVAULT_LLM_EXTRACTION_PROVIDER=ollama
#
# Ollama 的 OpenAI 兼容 chat 端点(默认 http://localhost:11434/v1):
# MEMVAULT_LLM_EXTRACTION_API_BASE=http://localhost:11434/v1
#
# 本地 chat 模型(默认 qwen2.5:7b;小机器可用 qwen2.5:3b-instruct):
# MEMVAULT_LLM_EXTRACTION_MODEL=qwen2.5:3b-instruct
#
# 本地无需 key;远程 provider 时设置:
# MEMVAULT_LLM_EXTRACTION_API_KEY=

# 可选:LLM 关系抽取(on 时 extract_memories(mode=llm) 额外持久化 supports/contradicts/sourced_from 三元组)
# MEMVAULT_RELATIONS=on

# ─── MemVault Server ──────────────────────────────────────
# MCP Server 数据文件路径（默认: ~/.memvault/data.db）
# MEMVAULT_DB=~/.memvault/data.db

# 可选：SQLite 连接池大小（默认: 5）
# MEMVAULT_DB_POOL_SIZE=5

# 可选：save 时 delta 写入（同命名空间先查重：近重复跳过、相似项合并残差）。
# 默认开启；off / 0 / false / disabled 关闭。单次旁路用 --force / force_insert。
# 见 docs/PAPER-INSPIRATIONS.md Feature A。
# MEMVAULT_DELTA_WRITE=off

# 可选：会话 n-gram 检索窗口（Feature D）——proxy 注入用最近多少轮观察构造
# 按新近度加权的检索键。默认 5。
# MEMVAULT_CONTEXT_NGRAM_WINDOW=5

# ─── REST API (--transport http) ──────────────────────────
# CORS 允许来源：逗号分隔的 origin 列表，或 * 显式放行所有来源（不推荐用于非可信网络）。
# 未设置时默认仅允许本机（127.0.0.1 / localhost，任意端口），以支持本地 MCP 客户端。
# MEMVAULT_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5173

# ─── 日志 ──────────────────────────────────────────────────
# 日志级别（格式: [target=]level，默认: info）
# RUST_LOG=info,memvault_core=debug